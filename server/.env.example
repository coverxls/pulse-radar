# ===== 数据库 =====
DATABASE_URL="file:./dev.db"

# ===== 服务 =====
PORT=3001
# 允许跨域/WebSocket 的前端地址，多个用逗号分隔
CLIENT_URL=http://localhost:5173
# 定时扫描的 cron 表达式（默认每 30 分钟）
CHECK_CRON=*/30 * * * *

# ===== AI（OpenRouter）=====
# 不填也能跑：相关性判定会降级为「关键词预匹配 + 默认分」，只是没法判断真假/生成摘要
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v3.2

# ===== Twitter（twitterapi.io，可选）=====
# 不填则跳过 Twitter 数据源，其他 5 个源照常工作
TWITTER_API_KEY=your_twitter_api_key_here

# ===== 邮件通知（可选）=====
# 不填则只做 WebSocket 推送，不发送邮件
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
NOTIFY_EMAIL=notify_to@example.com
