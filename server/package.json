{
  "name": "@pulseradar/server",
  "version": "1.0.0",
  "description": "PulseRadar API：多源聚合抓取 + AI 相关性判定 + WebSocket 实时推送 + 邮件通知",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "test:sources": "tsx src/test-sources.ts"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.5.1",
    "@prisma/client": "^6.19.2",
    "axios": "^1.13.4",
    "cheerio": "^1.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.0",
    "prisma": "^6.19.2",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.0",
    "@types/nodemailer": "^7.0.9",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
